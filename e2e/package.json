{
  "name": "qlkho-e2e",
  "private": true,
  "description": "Kiểm thử tự động giao diện và API cho qlkho-web (Playwright)",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:online": "playwright test --project=chromium --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report output/report",
    "bddgen": "bddgen",
    "bdd": "bddgen && playwright test --project=bdd --workers=1",
    "bdd:smoke": "bddgen && playwright test --project=bdd --workers=1 --grep @smoke",
    "bdd:after-reset": "bddgen && playwright test --project=bdd --workers=1 --grep @after-reset",
    "bdd:regression": "bddgen && playwright test --project=bdd --workers=1 --grep @regression --grep-invert @exclusive",
    "bdd:exclusive": "bddgen && playwright test --project=bdd --workers=1 --grep @exclusive",
    "allure:clean": "node scripts/allure.mjs clean",
    "allure:generate": "node scripts/allure.mjs generate",
    "allure:open": "node scripts/allure.mjs open",
    "bdd:allure": "npm run allure:clean && bddgen && playwright test --project=bdd",
    "test:allure": "npm run allure:clean && playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.10.5",
    "allure": "3.22.1",
    "allure-playwright": "3.3.3",
    "playwright-bdd": "^8.5.1"
  }
}
